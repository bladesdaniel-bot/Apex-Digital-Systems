# Copy this file to .env and fill in your real values. .env is never pushed to GitHub.

# Owner / admin
VITE_OWNER_EMAIL=you@example.com

# Supabase (browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase (server only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
VITE_PAYMENTS_CLIENT_TOKEN=pk_test_xxx

# Google Maps (call-list business lookups)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# AI, email sending and scheduled jobs (hosting platform)
LOVABLE_API_KEY=your-ai-gateway-key
LOVABLE_SEND_URL=https://your-email-send-endpoint
LOVABLE_CRON_SECRET=your-cron-secret
